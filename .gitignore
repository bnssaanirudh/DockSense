.code-review-graph/
.DS_Store
node_modules/
dist/
# ...but the built console IS committed: the demo must run offline from one
# command, with no node and no npm install on the demo machine.
!apps/web/dist/
!apps/web/dist/**
*.tsbuildinfo
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest_tmp/
pytest-cache-files-*/
*.egg-info/

# Data + models — keep dirs, ignore contents.
# Public footage is re-fetchable via scripts/fetch_public_data.py, so it is
# reproducible without being committed. Provenance lives in project.md.
data/raw/*
# Session directories are traversed only so takes.csv can be tracked; the
# footage itself never enters git.
!data/raw/*/
data/raw/*/*
!data/raw/*/takes.csv
data/processed/*
data/clips/*
data/public/*
data/test_tmp/*
# Synthetic physics clips are regenerated by scripts/render_synthetic.py
# (deterministic — same seed, same frames). Script is committed, output is not.
data/synthetic/*
!data/**/.gitkeep
!data/raw/takes.csv
!data/raw/*/takes.csv
!data/synthetic/ground_truth.csv
!data/synthetic/heldout/
!data/synthetic/heldout/ground_truth.csv
data/synthetic/heldout/*.mp4
data/synthetic/heldout/*.json
data/synthetic/heldout/*.png
# Detector weights ARE committed — the offline demo depends on them being
# in the clone. Only ignore incidental checkpoints from elsewhere.
models/**/checkpoints/
models/.cache_home/
runs/
*.db

# Keep small demo assets only
!data/sample/**
